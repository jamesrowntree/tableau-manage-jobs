# Tableau Cloud connection settings.
# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Personal Access Token - create under:
#   Tableau Cloud -> account menu -> My Account Settings -> Personal Access Tokens
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=

# Your Tableau Cloud pod URL, e.g. https://10ax.online.tableau.com
TABLEAU_SERVER_URL=

# Site "content URL" - the segment after /site/ in the browser address bar when
# signed into Tableau Cloud. Use an empty string only for the Default site.
TABLEAU_SITE_CONTENT_URL=
